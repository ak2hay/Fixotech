POSTGRES_PASSWORD=replace-with-a-long-password
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
# openssl rand -base64 48 (required in production; encrypts MFA secrets)
MFA_ENCRYPTION_KEY=replace-with-another-long-random-string
REDIS_PASSWORD=replace-with-a-long-redis-password
# Encrypts deploy/backup.sh archives. Store a copy outside the VM; backups cannot be restored without it.
BACKUP_PASSPHRASE=replace-with-a-long-backup-passphrase
BACKUP_KEEP_DAYS=14
API_PORT=4000
API_HOST_PORT=4200
TRUST_PROXY="loopback, linklocal, uniquelocal"
# Also set on each Vercel project (server-side env, not NEXT_PUBLIC_). openssl rand -base64 48
PROXY_SHARED_SECRET=replace-with-a-long-proxy-secret
# Credentialed CORS: list exact origins. A wildcard such as https://*-team-projects.vercel.app also matches
# any other Vercel project whose name ends in "-team-projects", so prefer exact preview URLs or a custom domain.
WEB_ORIGIN=https://fixotec-web.vercel.app
PORTAL_ORIGIN=https://fixotec-portal.vercel.app
ERP_ORIGIN=https://fixotec-erp.vercel.app
API_PUBLIC_URL=https://fixotec-api.95-135-254-46.sslip.io
STORAGE_DRIVER=local
LOG_LEVEL=info
# Error reporting (optional). Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# OpenAPI docs at /api/docs are off in production unless enabled here.
SWAGGER_ENABLED=false
# Used once by the seed. Choose a unique password and change it again after first sign-in.
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Set these on the web, portal and ERP Vercel projects while the build is a pitch demo.
# Demo mode is on unless NEXT_PUBLIC_DEMO_MODE=false. DEMO_USER/DEMO_PASS gate the public site.
# NEXT_PUBLIC_DEMO_MODE=true
# DEMO_USER=fixotec
# DEMO_PASS=replace-with-a-demo-password
