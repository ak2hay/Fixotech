DATABASE_URL=postgresql://fixotec:fixotec@localhost:5435/fixotec
REDIS_URL=redis://localhost:6381
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
# At least 32 characters; required in production. Encrypts MFA secrets at rest. Do not rotate without re-enrolling MFA.
MFA_ENCRYPTION_KEY=
API_PORT=4000
# Proxies whose X-Forwarded-For is trusted (Express "trust proxy" syntax).
TRUST_PROXY=loopback, linklocal, uniquelocal
BODY_LIMIT=1mb
# Same value on the API and on every Vercel project. The Next.js proxies send it with the visitor's IP
# (x-fixotec-client-ip); the API ignores that header unless the key matches. openssl rand -base64 48
PROXY_SHARED_SECRET=
# Comma-separated. Add the Vercel URLs, and a preview wildcard such as https://fixotec-web-*.vercel.app
WEB_ORIGIN=http://localhost:3000
PORTAL_ORIGIN=http://localhost:3001
ERP_ORIGIN=http://localhost:3002
API_PUBLIC_URL=http://localhost:4000
# Set on each Vercel project so the site proxies /api/v1 to the VM. Not exposed to the browser.
# API_PROXY_URL=http://YOUR_VM_IP:4000
# Optional. When set, the browser calls the VM directly (must be HTTPS). Leave empty to use the Vercel proxy.
# NEXT_PUBLIC_API_URL=https://api.fixotec.example
STORAGE_DRIVER=local
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
# Pin your directory (tenant) ID. "common" is accepted only together with MICROSOFT_ALLOWED_TENANTS.
MICROSOFT_TENANT_ID=
MICROSOFT_ALLOWED_TENANTS=
# Public enquiry form CAPTCHA (Cloudflare Turnstile or hCaptcha siteverify endpoint).
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# CAD/BIM: website visitors leave contact details before downloading (creates CAD_DOWNLOAD leads).
CAD_DOWNLOAD_GATE=true
# Largest CAD/BIM upload in MB (Revit families and projects). Keep PROXY_LARGE_UPLOAD_MB and nginx in step.
CAD_MAX_MB=250
PROXY_LARGE_UPLOAD_MB=250
# With STORAGE_DRIVER=s3, large files upload straight to the bucket: allow PUT from the ERP origin in the bucket CORS policy.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fixotec <noreply@fixotec.local>
# CRM inbound email: point SendGrid Inbound Parse / Mailgun routes / Postmark at
# https://API/api/v1/public/crm/inbound-email?key=<INBOUND_EMAIL_SECRET>  (24+ characters)
INBOUND_EMAIL_SECRET=
# WhatsApp Cloud API (Meta). Webhook URL: https://API/api/v1/public/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# GST e-invoice (IRN) and e-way bill through a GST Suvidha Provider. NONE | SANDBOX (fake IRNs for testing) | GENERIC
GSP_PROVIDER=NONE
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_USERNAME=
GSP_PASSWORD=
GSTIN=
# Razorpay payment links on invoices. Webhook: https://API/api/v1/public/razorpay/webhook
# (events: payment_link.paid, payment_link.expired, payment_link.cancelled). Receipts post to Payment Gateway Clearing;
# the settlement line on the bank statement clears it through the starter "Payment gateway settlement" bank rule.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# At least 32 characters. Encrypts employee PAN, Aadhaar and bank account numbers. Do not rotate without re-encrypting.
PII_ENCRYPTION_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
ACCOUNTING_TARGET=TALLY
TALLY_BASE_URL=
# Company name exactly as in Tally; the native ledger's Tally XML export imports into this company.
TALLY_COMPANY=Fixotec
ZOHO_BOOKS_BASE_URL=
ZOHO_BOOKS_TOKEN=
SEED_ADMIN_EMAIL=admin@demo.fixotec.test
SEED_ADMIN_PASSWORD=ChangeMe!234
# Pitch/demo safeguards on the web, portal and ERP apps (set on each Vercel project too).
# On unless set to "false": noindex everywhere, demo banners, password gate on the public site.
NEXT_PUBLIC_DEMO_MODE=true
# HTTP Basic Auth for the public site while in demo mode. Required in production builds.
DEMO_USER=fixotec
DEMO_PASS=
