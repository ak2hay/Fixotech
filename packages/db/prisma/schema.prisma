  startedAt  DateTime
  endedAt    DateTime?
  minutes    Int?
  @@index([employeeId, startedAt])
  @@index([jobCardId])
}

model AppraisalCycle {
  id         String    @id @default(cuid())
  name       String
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  selfDue    DateTime? @db.Date
  managerDue DateTime? @db.Date
  status     String    @default("DRAFT")
  createdAt  DateTime  @default(now())
  goals      Goal[]
  appraisals Appraisal[]
}

model Goal {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId     String?
  cycle       AppraisalCycle? @relation(fields: [cycleId], references: [id])
  title       String
  description String?
  weight      Int             @default(0)
  target      String?
  progress    Int             @default(0)
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  @@index([employeeId])
}

model Appraisal {
  id              String         @id @default(cuid())
  cycleId         String
  cycle           AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status          String         @default("SELF")
  selfRating      Decimal?       @db.Decimal(2, 1)
  selfComments    String?
  managerRating   Decimal?       @db.Decimal(2, 1)
  managerComments String?
  reviewerId      String?
  completedAt     DateTime?
  @@unique([cycleId, employeeId])
}

model DistributorTarget {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  period        String
  metric        String   @default("REVENUE")
  targetAmount  Decimal  @db.Decimal(14, 2)
  achievedAmount Decimal @default(0) @db.Decimal(14, 2)
}

model Scheme {
  id          String   @id @default(cuid())
  name        String
  description String?
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean  @default(true)
  claims      SchemeClaim[]
}

model SchemeClaim {
  id         String   @id @default(cuid())
  schemeId   String
  scheme     Scheme   @relation(fields: [schemeId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  status     String   @default("SUBMITTED")
  notes      String?
  createdAt  DateTime @default(now())
}

model Solution {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  summary         String
  body            String
  applications    String[] @default([])
  features        String[] @default([])
  imageKey        String?
  heroImageKey    String?
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
}

model Industry {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  summary         String
  body            String
  group           String   @default("BUILDINGS")
  features        String[] @default([])
  imageKey        String?
  heroImageKey    String?
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  imageKey    String?
  publishedAt DateTime  @default(now())
  sourceUrl   String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([publishedAt])
}

model ServiceArea {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  summary   String
  iconKey   String?
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model CaseStudy {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  location  String?
  sector    String?
  summary   String
  body      String
  year      Int?
  published Boolean @default(true)
}

model CmsBlock {
  key       String  @id
  title     String
  subtitle  String?
  body      String?
  data      Json?
  published Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model ConfiguratorRule {
  id           String   @id @default(cuid())
  installing   String
  application  String?
  installation String?
  environment  String?
  minSizeMm    Int?
  maxSizeMm    Int?
  label        String
  articles     String[]
  priority     Int      @default(0)
  active       Boolean  @default(true)
}

/// One supplier document from the GSTR-2B JSON downloaded from the GST portal.
model Gstr2bEntry {
  id            String    @id @default(cuid())
  period        String
  supplierGstin String
  supplierName  String?
  docType       String    @default("INV")
  invoiceNo     String
  invoiceDate   DateTime
  invoiceValue  Decimal   @db.Decimal(14, 2)
  placeOfSupply String?
  reverseCharge Boolean   @default(false)
  taxable       Decimal   @db.Decimal(14, 2)
  igst          Decimal   @default(0) @db.Decimal(14, 2)
  cgst          Decimal   @default(0) @db.Decimal(14, 2)
  sgst          Decimal   @default(0) @db.Decimal(14, 2)
  cess          Decimal   @default(0) @db.Decimal(14, 2)
  itcAvailable  Boolean   @default(true)
  itcReason     String?
  matchStatus   String    @default("UNMATCHED")
  differences   String[]  @default([])
  vendorBillId  String?
  action        String    @default("PENDING")
  notes         String?
  importedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([period, supplierGstin, docType, invoiceNo])
  @@index([period, matchStatus])
  @@index([vendorBillId])
}

model GstFiling {
  id          String   @id @default(cuid())
  period      String
  returnType  String
  status      String   @default("FILED")
  arn         String?
  filedOn     DateTime
  summary     Json
  createdById String?
  createdAt   DateTime @default(now())
  @@unique([period, returnType])
}

/// One uploaded statement file; its lines are BankTransaction rows (deduplicated across overlapping files by hash).
model BankStatement {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id])
  fileName       String
  format         String
  bank           String?
  fromDate       DateTime? @db.Date
  toDate         DateTime? @db.Date
  openingBalance Decimal?  @db.Decimal(16, 2)
  closingBalance Decimal?  @db.Decimal(16, 2)
  lineCount      Int       @default(0)
  duplicates     Int       @default(0)
  warnings       String[]
  importedById   String?
  createdAt      DateTime  @default(now())
  transactions   BankTransaction[]
  @@index([accountId, createdAt])
}

model BankTransaction {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  statementId String?
  statement   BankStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  date        DateTime  @db.Date
  valueDate   DateTime? @db.Date
  description String
  reference   String?
  utr         String?
  debit       Decimal   @default(0) @db.Decimal(16, 2)
  credit      Decimal   @default(0) @db.Decimal(16, 2)
  balance     Decimal?  @db.Decimal(16, 2)
  hash        String    @unique
  /// UNMATCHED | SUGGESTED | MATCHED | IGNORED
  status      String    @default("UNMATCHED")
  suggestion  Json?
  ruleId      String?
  matchedById String?
  matchedAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  matches     BankMatch[]
  @@index([accountId, date])
  @@index([accountId, status])
}

/// Links a statement line to the book entries it clears: payments (one line can settle several) or a journal.
model BankMatch {
  id             String          @id @default(cuid())
  transactionId  String
  transaction    BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  paymentId      String?         @unique
  payment        Payment?        @relation(fields: [paymentId], references: [id])
  journalEntryId String?         @unique
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  amount         Decimal         @db.Decimal(16, 2)
  createdAt      DateTime        @default(now())
  @@index([transactionId])
}

model BankRule {
  id               String   @id @default(cuid())
  name             String
  /// Keywords separated by |, matched case-insensitively against narration and reference.
  contains         String
  direction        String   @default("ANY")
  bankAccountId    String?
  counterAccountId String
  counterAccount   Account  @relation("BankRuleCounter", fields: [counterAccountId], references: [id])
  minAmount        Decimal? @db.Decimal(16, 2)
  maxAmount        Decimal? @db.Decimal(16, 2)
  narration        String?
  autoPost         Boolean  @default(false)
  priority         Int      @default(100)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

/// A batch of payouts exported as one bank upload file. DRAFT → APPROVED → EXPORTED → COMPLETED.
model PaymentRun {
  id           String    @id @default(cuid())
  number       String    @unique
  kind         String    @default("VENDOR")
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])
  bankFormat   String    @default("GENERIC")
  valueDate    DateTime  @db.Date
  status       String    @default("DRAFT")
  total        Decimal   @db.Decimal(16, 2)
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  exportedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  items        PaymentRunItem[]
  @@index([status])
}

model PaymentRunItem {
  id           String     @id @default(cuid())
  runId        String
  run          PaymentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id])
  vendorBillId String?
  employeeId   String?
  sourceType   String?
  sourceId     String?
  payeeName    String
  accountNo    String
  ifsc         String
  email        String?
  amount       Decimal    @db.Decimal(16, 2)
  tdsAmount    Decimal    @default(0) @db.Decimal(16, 2)
  mode         String?
  reference    String
  paymentId    String?    @unique
  payment      Payment?   @relation(fields: [paymentId], references: [id])
  status       String     @default("PENDING")
  error        String?
  @@index([runId])
  @@index([sourceType, sourceId])
}

model PaymentLink {
  id                String    @id @default(cuid())
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id])
  provider          String    @default("RAZORPAY")
  providerId        String    @unique
  shortUrl          String
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("INR")
  /// CREATED | PAID | EXPIRED | CANCELLED
  status            String    @default("CREATED")
  providerPaymentId String?   @unique
  fee               Decimal?  @db.Decimal(14, 2)
  paymentId         String?   @unique
  payment           Payment?  @relation(fields: [paymentId], references: [id])
  expiresAt         DateTime?
  paidAt            DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  @@index([invoiceId])
}
