  salesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  description      String
  qty              Decimal  @db.Decimal(14, 3)
  rate             Decimal  @db.Decimal(14, 2)
  taxRate          Decimal  @default(18) @db.Decimal(5, 2)
  amount           Decimal  @db.Decimal(14, 2)
  hsn              String?
  uqc              String?
  cgst             Decimal  @default(0) @db.Decimal(14, 2)
  sgst             Decimal  @default(0) @db.Decimal(14, 2)
  igst             Decimal  @default(0) @db.Decimal(14, 2)
  @@index([invoiceId])
}

model VendorBill {
  id              String   @id @default(cuid())
  number          String   @unique
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  status          String   @default("OPEN")
  vendorInvoiceNo String?
  billDate        DateTime?
  subtotal        Decimal? @db.Decimal(14, 2)
  tax             Decimal? @db.Decimal(14, 2)
  /// Ledger account for non-stock bills (services, rent, ...); stock bills clear GRNI.
  expenseAccountId String?
  source          String?
  cgst            Decimal  @default(0) @db.Decimal(14, 2)
  sgst            Decimal  @default(0) @db.Decimal(14, 2)
  igst            Decimal  @default(0) @db.Decimal(14, 2)
  reverseCharge   Boolean  @default(false)
  itcEligible     Boolean  @default(true)
  /// Latest GSTR-2B reconciliation outcome: MATCHED, MISMATCH, PROBABLE, MISSING_IN_2B.
  itcStatus       String?
  total           Decimal  @db.Decimal(14, 2)
  dueDate         DateTime?
  createdAt       DateTime @default(now())
  payments        Payment[]
  debitNotes      DebitNote[]
  @@index([vendorId, status])
}

model Payment {
  id              String    @id @default(cuid())
  number          String    @unique
  direction       String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  vendorId        String?
  vendor          Vendor?   @relation(fields: [vendorId], references: [id])
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  vendorBillId    String?
  vendorBill      VendorBill? @relation(fields: [vendorBillId], references: [id])
  amount          Decimal   @db.Decimal(14, 2)
  method          String    @default("NEFT")
  currency        String    @default("INR")
  exchangeRate    Decimal   @default(1) @db.Decimal(14, 6)
  /// Ledger bank/cash account the money moved through; defaults to the primary bank.
  accountId       String?
  /// `amount` is what the payment settles; cash moved is amount - tdsAmount - charges (IN) or amount - tdsAmount + charges (OUT).
  tdsAmount       Decimal   @default(0) @db.Decimal(14, 2)
  charges         Decimal   @default(0) @db.Decimal(14, 2)
  tdsSection      String?
  source          String?
  reference       String?
  status          String    @default("POSTED")
  paidAt          DateTime  @default(now())
  createdAt       DateTime  @default(now())
  createdById     String?
  bankMatch       BankMatch?
  paymentLink     PaymentLink?
  runItem         PaymentRunItem?
  @@index([customerId, paidAt])
  @@index([vendorId])
  @@index([invoiceId])
  @@index([vendorBillId])
}

model Expense {
  id          String    @id @default(cuid())
  number      String    @unique
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  category    String
  amount      Decimal   @db.Decimal(14, 2)
  status      String    @default("DRAFT")
  description String?
  spentOn     DateTime?
  /// Set when the claim is reimbursed through a payslip instead of a separate bank payment.
  payslipId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([employeeId, status])
}

/// Chart of accounts. `systemKey` marks accounts the posting engine uses (AR, AP, SALES, CGST_OUT, ...).
model Account {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  type          String
  subtype       String?
  systemKey     String?   @unique
  parentId      String?
  parent        Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[] @relation("AccountTree")
  isGroup       Boolean   @default(false)
  currency      String    @default("INR")
  bankAccountId String?   @unique
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  externalRef   String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lines         JournalLine[]
  openings      OpeningBalance[]
  bankStatements   BankStatement[]
  bankTransactions BankTransaction[]
  bankRules        BankRule[]        @relation("BankRuleCounter")
  paymentRuns      PaymentRun[]
  @@index([type])
  @@index([parentId])
}

/// Immutable once written (database triggers); corrections are reversal entries.
model JournalEntry {
  id           String    @id @default(cuid())
  number       String    @unique
  date         DateTime
  narration    String
  reference    String?
  sourceType   String?
  sourceId     String?
  /// Idempotency key for automatic postings, e.g. "invoice:<id>".
  postingKey   String?   @unique
  currency     String    @default("INR")
  exchangeRate Decimal   @default(1) @db.Decimal(14, 6)
  total        Decimal   @db.Decimal(16, 2)
  reversalOfId String?   @unique
  reversalOf   JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("Reversal")
  createdById  String?
  createdAt    DateTime  @default(now())
  lines        JournalLine[]
  bankMatch    BankMatch?
  @@index([date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id           String       @id @default(cuid())
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date         DateTime
  debit        Decimal      @default(0) @db.Decimal(16, 2)
  credit       Decimal      @default(0) @db.Decimal(16, 2)
  /// Amount in the entry's foreign currency (signed: + debit, - credit).
  fcAmount     Decimal?     @db.Decimal(16, 2)
  description  String?
  partyType    String?
  partyId      String?
  costCenterId String?
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id])
  projectId    String?
  @@index([entryId])
  @@index([accountId, date])
  @@index([partyType, partyId, date])
}

