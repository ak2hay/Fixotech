generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  kind         String    @default("STAFF")
  active       Boolean   @default(true)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  mfaLastStep  Int?
  mfaRecoveryCodes String[] @default([])
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  passwordChangedAt DateTime?
  identities   UserIdentity[]
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  jobTitle     String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  roles        UserRole[]
  sessions     Session[]
  notifications Notification[]
  employee     Employee?
  ownedLeads   Lead[]       @relation("LeadOwner")
  ownedActivities Activity[] @relation("ActivityOwner")
  ownedProjects Project[]   @relation("ProjectOwner")
  assignedRfqs Rfq[]        @relation("RfqAssignee")
  engineeringJobs EngineeringRequest[] @relation("Engineer")
  comments     Comment[]
  siteVisits   SiteVisit[]
  assignedIssues SiteIssue[] @relation("IssueAssignee")
  assignedTickets ServiceTicket[] @relation("TicketAssignee")
  stockMovements InventoryTransaction[] @relation("InventoryActor")
  @@index([customerId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  kind        String   @default("STAFF")
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique
  resource String
  action   String
  roles    RolePermission[]
  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  tenantId  String?
  email     String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  @@unique([provider, subject])
  @@unique([userId, provider])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
}

model LegalEntity {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  gstin       String?
  pan         String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  taxRegs     TaxRegistration[]
  bankAccounts BankAccount[]
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  region    String
  /// Two-letter state code (MH, TN, DL, KA ...) used for professional tax and labour welfare fund.
  state     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offices   Office[]
  plants    Plant[]
  users     User[]
  employees Employee[]
  journalLines JournalLine[]
  holidays  Holiday[]
  leavePolicies LeavePolicy[]
}

model Office {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  active    Boolean @default(true)
}

model Plant {
  id         String @id @default(cuid())
  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])
  code       String @unique
  name       String
  address    String?
  active     Boolean @default(true)
  warehouses Warehouse[]
  workCenters WorkCenter[]
}

model Department {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  users     User[]
  employees Employee[]
  costCenters CostCenter[]
}

model CostCenter {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  active       Boolean    @default(true)
  journalLines JournalLine[]
}

model ProfitCenter {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  active Boolean @default(true)
}

model FinancialYear {
  id        String   @id @default(cuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(false)
}

model TaxRegistration {
  id            String      @id @default(cuid())
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  type          String
  number        String
}

model BankAccount {
  id            String      @id @default(cuid())
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  bankName      String
  accountNo     String
  ifsc          String?
  currency      String      @default("INR")
  active        Boolean     @default(true)
  ledgerAccount Account?
}

model Currency {
  code      String  @id
  name      String
  symbol    String
  rateToInr Decimal @default(1) @db.Decimal(14, 4)
  active    Boolean @default(true)
}

model UnitOfMeasure {
  code String @id
  name String
}

model BusinessSetting {
  key   String @id
  value Json
}

model NumberSequence {
  key    String @id
  prefix String
  next   Int    @default(1)
  pad    Int    @default(4)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}

model DomainEvent {
  id        String   @id @default(cuid())
  name      String
  payload   Json
  status    String   @default("PROCESSED")
  createdAt DateTime @default(now())
  @@index([name, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  channel    String    @default("IN_APP")
  emailStatus String?
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime  @default(now())
  @@index([userId, readAt])
}

model WorkflowEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fromStatus String?
  toStatus   String
  actorId    String?
  comment    String?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

model Comment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

model ApprovalRule {
  id           String  @id @default(cuid())
  name         String
  entityType   String
  condition    Json
  approverRole String
  priority     Int     @default(0)
  active       Boolean @default(true)
}

model ApprovalRequest {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  ruleId       String?
  status       String   @default("PENDING")
  requesterId  String?
  approverRole String
  snapshot     Json?
  decidedById  String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime @default(now())
  @@index([entityType, entityId])
  @@index([status])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  category    String
  entityType  String?
  entityId    String?
  audiences   String[] @default([])
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Soft delete: archived documents stay as evidence but are hidden from every listing and download.
  deletedAt   DateTime?
  versions    DocumentVersion[]
  shares      DocumentShare[]
  downloads   DocumentDownload[]
  @@index([entityType, entityId])
  @@index([category])
}

/// One row per file served (ERP, portal, public website, share link or zip bundle) for download analytics.
model DocumentDownload {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version    Int
  channel    String
  userId     String?
  leadId     String?
  ip         String?
  createdAt  DateTime @default(now())
  @@index([documentId, createdAt])
  @@index([leadId])
  @@index([createdAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version     Int
  status      String   @default("DRAFT")
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  thumbnailKey String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  @@unique([documentId, version])
}

model DocumentShare {
  id                String          @id @default(cuid())
  documentId        String
  document          Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersionId String
  /// SHA-256 of the share token; the token itself is only returned once.
  token             String          @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  createdById       String?
  createdAt         DateTime        @default(now())
  @@index([documentId])
}

model Customer {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  type          String
  gstin         String?
  email         String?
  phone         String?
  website       String?
  creditLimit   Decimal  @default(0) @db.Decimal(14, 2)
  paymentTerms  String?
  priceList     String   @default("STANDARD")
  notes         String?
  active        Boolean  @default(true)
  customFields  Json?
  mergedIntoId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contacts      Contact[]
  addresses     Address[]
  users         User[]
  leads         Lead[]
  clientProjects      Project[] @relation("ProjectClient")
  developerProjects   Project[] @relation("ProjectDeveloper")
  consultantProjects  Project[] @relation("ProjectConsultant")
  pmcProjects         Project[] @relation("ProjectPmc")
  creditNotes         CreditNote[]
  contractorProjects  Project[] @relation("ProjectContractor")
  mepProjects         Project[] @relation("ProjectMep")
  rfqs          Rfq[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  tickets       ServiceTicket[]
  payments      Payment[]
  targets       DistributorTarget[]
  claims        SchemeClaim[]
  engineering   EngineeringRequest[]
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  title      String?
  primary    Boolean  @default(false)
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String   @default("India")
  gstin      String?
}

model Lead {
  id             String   @id @default(cuid())
  number         String   @unique
  source         String
  status         String   @default("NEW")
  contactName    String
  companyName    String
  email          String?
  phone          String?
  application    String?
  message        String?
  estimatedValue Decimal? @db.Decimal(14, 2)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  ownerId        String?
  owner          User?    @relation("LeadOwner", fields: [ownerId], references: [id])
  score          Int      @default(0)
  lostReason     String?
  region         String?
  segment        String?
  nextFollowUpAt DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  customFields   Json?
  mergedIntoId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activities     LeadActivity[]
  rfqs           Rfq[]
  @@index([status])
  @@index([ownerId])
  @@index([customerId])
  @@index([email])
  @@index([phone])
}

/// Calls, meetings, tasks, emails, notes and WhatsApp messages against any CRM record.
model Activity {
  id           String    @id @default(cuid())
  type         String
  subject      String
  body         String?
  status       String    @default("OPEN")
  direction    String?
  dueAt        DateTime?
  completedAt  DateTime?
  remindedAt   DateTime?
  entityType   String
  entityId     String
  contactEmail String?
  contactPhone String?
  externalId   String?   @unique
  ownerId      String?
  owner        User?     @relation("ActivityOwner", fields: [ownerId], references: [id])
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([entityType, entityId, createdAt])
  @@index([ownerId, status, dueAt])
  @@index([status, dueAt])
}

model CustomFieldDef {
  id        String   @id @default(cuid())
  entity    String
  key       String
  label     String
  type      String
  options   String[] @default([])
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@unique([entity, key])
}

model LeadScoringRule {
  id        String   @id @default(cuid())
  name      String
  field     String
  op        String
  value     String?
  points    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AssignmentRule {
  id        String   @id @default(cuid())
  name      String
  priority  Int      @default(100)
  condition Json
  userIds   String[]
  cursor    Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sequence {
  id          String   @id @default(cuid())
  name        String
  entityType  String   @default("quotation")
  steps       Json
  /// Sent quotations are enrolled automatically (first active auto sequence wins).
  autoEnroll  Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  enrollments SequenceEnrollment[]
}

model SequenceEnrollment {
  id         String    @id @default(cuid())
  sequenceId String
  sequence   Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  email      String
  step       Int       @default(0)
  nextRunAt  DateTime?
  status     String    @default("ACTIVE")
  lastError  String?
  createdById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@unique([sequenceId, entityType, entityId])
  @@index([status, nextRunAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  type      String
  note      String
  createdAt DateTime @default(now())
  @@index([leadId])
}

model Project {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  location            String?
  customerId          String
  customer            Customer  @relation("ProjectClient", fields: [customerId], references: [id])
  developerId         String?
  developer           Customer? @relation("ProjectDeveloper", fields: [developerId], references: [id])
  consultantId        String?
  consultant          Customer? @relation("ProjectConsultant", fields: [consultantId], references: [id])
  pmcId               String?
  pmc                 Customer? @relation("ProjectPmc", fields: [pmcId], references: [id])
  contractorId        String?
  contractor          Customer? @relation("ProjectContractor", fields: [contractorId], references: [id])
  mepContractorId     String?
  mepContractor       Customer? @relation("ProjectMep", fields: [mepContractorId], references: [id])
  projectValue        Decimal?  @db.Decimal(14, 2)
  fixotecValue        Decimal?  @db.Decimal(14, 2)
  startDate           DateTime?
  expectedCompletion  DateTime?
  stage               String    @default("IDENTIFIED")
  probability         Int       @default(20)
  ownerId             String?
  owner               User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  notes               String?
  coverImageKey       String?
  health              String?
  customFields        Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  members             ProjectMember[]
  milestones          ProjectMilestone[]
  leads               Lead[]
  rfqs                Rfq[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  boqs                Boq[]
  engineering         EngineeringRequest[]
  submittals          Submittal[]
  siteVisits          SiteVisit[]
  siteReports         SiteReport[]
  siteIssues          SiteIssue[]
  consumptions        MaterialConsumption[]
  tickets             ServiceTicket[]
  @@index([stage])
  @@index([customerId])
  @@index([developerId])
  @@index([consultantId])
  @@index([pmcId])
  @@index([contractorId])
  @@index([mepContractorId])
  @@index([ownerId])
}

model ProjectMember {
  projectId String
  userId    String
  role      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String
  label       String
  sortOrder   Int
  plannedDate DateTime?
  actualDate  DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([projectId, key])
  @@index([projectId, sortOrder])
}

model ProductFamily {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  products   Product[]
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageKey    String?
  sortOrder   Int       @default(0)
  parentId    String?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]
  @@index([parentId])
}

model Product {
  id                    String   @id @default(cuid())
  familyId              String?
  family                ProductFamily? @relation(fields: [familyId], references: [id])
  categoryId            String?
  category              ProductCategory? @relation(fields: [categoryId], references: [id])
  productType           String   @default("FINISHED")
  sku                   String   @unique
  name                  String
  slug                  String   @unique
  description           String?
  technicalDescription  String?
  applications          String[] @default([])
  material              String?
  coating               String?
  finish                String?
  hsn                   String?
  gstRate               Decimal  @default(18) @db.Decimal(5, 2)
  manufacturingMethod   String?
  leadTimeDays          Int      @default(14)
  moq                   Decimal  @default(1) @db.Decimal(14, 3)
  packSize              String?
  supplyMode            String   @default("MAKE")
  purchaseCost          Decimal  @default(0) @db.Decimal(14, 2)
  manufacturingCost     Decimal  @default(0) @db.Decimal(14, 2)
  standardPrice         Decimal  @default(0) @db.Decimal(14, 2)
  weightKg              Decimal? @db.Decimal(14, 3)
  loadCapacity          String?
  thread                String?
  pipeSize              String?
  lengthLabel           String?
  revision              String   @default("A")
  published             Boolean  @default(false)
  metaTitle             String?
  metaDescription       String?
  imageKeys             String[] @default([])
  heroImageKey          String?
  features              String[] @default([])
  segments              String[] @default([])
  sectors               String[] @default([])
  sourceUrl             String?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  variants              ProductVariant[]
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  articleNumber      String   @unique
  sku                String   @unique
  name               String
  attributes         Json
  barcode            String?  @unique
  purchaseCost       Decimal  @db.Decimal(14, 2)
  manufacturingCost  Decimal  @db.Decimal(14, 2)
  standardPrice      Decimal  @db.Decimal(14, 2)
  customerPrice      Decimal? @db.Decimal(14, 2)
  dealerPrice        Decimal? @db.Decimal(14, 2)
  exportPrice        Decimal? @db.Decimal(14, 2)
  safetyStock        Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel       Decimal  @default(0) @db.Decimal(14, 3)
  active             Boolean  @default(true)
  rfqItems           RfqItem[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  boqItems           BoqItem[]
  balances           InventoryBalance[]
  bomParents         Bom[]
  bomComponents      BomItem[] @relation("BomComponent")
  stockMovements     InventoryTransaction[]
  productionOrders   ProductionOrder[] @relation("ProductionVariant")
  @@index([productId])
}

model Rfq {
  id          String   @id @default(cuid())
  number      String   @unique
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  status      String   @default("DRAFT")
  application String?
  notes       String?
  dueDate     DateTime?
  priority    String   @default("MEDIUM")
  assigneeId  String?
  assignee    User?    @relation("RfqAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       RfqItem[]
  quotations  Quotation[]
  engineering EngineeringRequest[]
  boqs        Boq[]
  @@index([status])
  @@index([customerId])
  @@index([projectId])
  @@index([assigneeId, status])
}

model RfqItem {
  id            String   @id @default(cuid())
  rfqId         String
  rfq           Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  description   String
  qty           Decimal  @db.Decimal(14, 3)
  unit          String   @default("NOS")
  specification String?
  @@index([rfqId])
}

model Quotation {
  id             String    @id @default(cuid())
  number         String    @unique
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  rfqId          String?
  rfq            Rfq?      @relation(fields: [rfqId], references: [id])
  status         String    @default("DRAFT")
  validUntil     DateTime?
  paymentTerms   String?
  deliveryTerms  String?
  currency       String    @default("INR")
  discountPct    Decimal   @default(0) @db.Decimal(5, 2)
  freight        Decimal   @default(0) @db.Decimal(14, 2)
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
